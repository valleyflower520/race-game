# ---------- 游戏状态 ----------
class GameState:
    def __init__(self):
        self.segment_length = 200
        self.num_segments = 50
        self.segments = []
        self.player_z = 0
        self.speed = 0
        self.max_speed = 15
        self.accel = 0.2
        self.brake = 0.15
        self.friction = 0.97
        self.steering = 0
        self.player_x = 0
        self.max_x = 3.5
        self.camera_height = 1000
        self.camera_depth = 1
        self.draw_distance = 120
        self.terrain_variation = 0.5
        
        self.generate_track()
    
    def generate_track(self):
        self.segments = []
        for i in range(self.num_segments):
            curve = 2.5 * math.sin(i * 0.15) + 1.0 * math.sin(i * 0.05 + 1.2)
            height = 0.6 * math.sin(i * 0.12) + 0.4 * math.cos(i * 0.07 + 0.8)
            rumble = 0.3 * math.sin(i * 0.3) if i % 3 == 0 else 0
            self.segments.append({
                'curve': curve,
                'height': height,
                'rumble': rumble,
                'x_offset': 0
            })
        
        world_x = 0
        for seg in self.segments:
            world_x += seg['curve']
            seg['x_offset'] = world_x

# ---------- 渲染函数 ----------
def render_pseudo3d(state):
    screen.fill(COLOR_SKY)
    pygame.draw.rect(screen, (50, 100, 50), (0, SCREEN_HEIGHT//2, SCREEN_WIDTH, SCREEN_HEIGHT//2))
    
    seg_index = int(state.player_z) % state.num_segments
    start_seg = seg_index
    end_seg = seg_index - state.draw_distance
    if end_seg < 0:
        end_seg += state.num_segments
    
    seg_list = []
    
    for i in range(state.draw_distance, -1, -1):
        seg_idx = (start_seg - i) % state.num_segments
        seg = state.segments[seg_idx]
        
        rel_dist = i
        world_x = seg['x_offset'] - state.player_x
        world_y = seg['height'] * state.terrain_variation
        
        z_scale = state.camera_height / (rel_dist + 0.1)
        screen_x = SCREEN_WIDTH//2 + int(world_x * z_scale * 0.5)
        screen_y = int(SCREEN_HEIGHT//2 + (world_y * 80) - (rel_dist * 0.5))
        
        segment_width = int(300 * z_scale / 100)
        if segment_width < 2:
            continue
        
        seg_list.append({
            'index': i,
            'screen_x': screen_x,
            'screen_y': screen_y,
            'width': segment_width,
            'seg_data': seg,
            'rel_dist': rel_dist
        })
    
    for item in reversed(seg_list):
        x = item['screen_x']
        y = item['screen_y']
        w = item['width']
        dist = item['rel_dist']
        seg = item['seg_data']
        
        dark_factor = max(0.3, 1.0 - dist / state.draw_distance)
        road_color = (int(60*dark_factor), int(60*dark_factor), int(60*dark_factor))
        line_color = (int(200*dark_factor), int(200*dark_factor), int(200*dark_factor))
        
        top_width = w
        bottom_width = w * 1.2 if dist > 0 else w * 0.8
        top_y = y - 10
        bottom_y = y + 15
        
        points = [
            (x - bottom_width//2, bottom_y),
            (x + bottom_width//2, bottom_y),
            (x + top_width//2, top_y),
            (x - top_width//2, top_y)
        ]
        pygame.draw.polygon(screen, COLOR_DIRT if dist > 5 else road_color, points)
        
        edge_color = (100, 70, 30) if dist > 5 else (80, 80, 80)
        pygame.draw.line(screen, edge_color, (x - bottom_width//2, bottom_y), (x - top_width//2, top_y), 2)
        pygame.draw.line(screen, edge_color, (x + bottom_width//2, bottom_y), (x + top_width//2, top_y), 2)
        
        if dist % 4 < 2:
            mid_x = x
            mid_y_top = top_y
            mid_y_bottom = bottom_y
            pygame.draw.line(screen, line_color, (mid_x, mid_y_top), (mid_x, mid_y_bottom), 2)
        
        if dist < 20 and dist > 2 and dist % 3 == 0:
            tree_x = x + random.choice([-w*0.8, w*0.8])
            tree_y = (top_y + bottom_y) // 2
            if 0 < tree_x < SCREEN_WIDTH:
                pygame.draw.circle(screen, (34, 139, 34), (int(tree_x), int(tree_y-5)), 8)
                pygame.draw.rect(screen, (101, 67, 33), (int(tree_x-2), int(tree_y-5), 4, 10))
    
    # 车辆
    car_x = SCREEN_WIDTH//2
    car_y = SCREEN_HEIGHT - 100
    pygame.draw.rect(screen, COLOR_CAR_BODY, (car_x-20, car_y-10, 40, 25), border_radius=6)
    pygame.draw.rect(screen, COLOR_CAR_WINDOW, (car_x-10, car_y-18, 20, 12), border_radius=4)
    pygame.draw.circle(screen, (30,30,30), (car_x-15, car_y+12), 6)
    pygame.draw.circle(screen, (30,30,30), (car_x+15, car_y+12), 6)
    pygame.draw.circle(screen, (255,255,150), (car_x-15, car_y-12), 3)
    pygame.draw.circle(screen, (255,255,150), (car_x+15, car_y-12), 3)
    
    font = pygame.font.Font(None, 30)
    speed_text = font.render(f"速度: {abs(state.speed)*10:.0f} km/h", True, (255,255,255))
    screen.blit(speed_text, (20, 20))
    
    hint = font.render("↑加速 ↓刹车 ← → 转向", True, (200,200,200))
    screen.blit(hint, (SCREEN_WIDTH-250, 20))

# ---------- 物理更新 ----------
def update_game(state):
    keys = pygame.key.get_pressed()
    if keys[K_UP]:
        state.speed += state.accel
    if keys[K_DOWN]:
        state.speed -= state.brake
    state.speed *= state.friction
    if state.speed > state.max_speed:
        state.speed = state.max_speed
    if state.speed < -state.max_speed/2:
        state.speed = -state.max_speed/2
    
    if keys[K_LEFT]:
        state.steering = -0.12 * (1 + abs(state.speed)*0.05)
    elif keys[K_RIGHT]:
        state.steering = 0.12 * (1 + abs(state.speed)*0.05)
    else:
        state.steering *= 0.85
    
    seg_idx = int(state.player_z) % state.num_segments
    curve_force = state.segments[seg_idx]['curve'] * 0.02 * state.speed
    state.player_x += state.steering + curve_force
    
    if state.player_x > state.max_x:
        state.player_x = state.max_x
    if state.player_x < -state.max_x:
        state.player_x = -state.max_x
    
    state.player_z += state.speed * 0.08
    if state.player_z >= state.num_segments:
        state.player_z -= state.num_segments
    if state.player_z < 0:
        state.player_z += state.num_segments

